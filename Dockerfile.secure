FROM python:3.11-slim AS builder

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir --user -r requirements.txt

FROM python:3.11-slim

ARG APP_USER=appuser
ARG APP_UID=1001

RUN groupadd -g ${APP_UID} ${APP_USER} && \
    useradd -r -u ${APP_UID} -g ${APP_USER} ${APP_USER} && \
    mkdir -p /app /data && \
    chown -R ${APP_USER}:${APP_USER} /app /data

WORKDIR /app

COPY --from=builder --chown=${APP_USER}:${APP_USER} /root/.local /home/${APP_USER}/.local
COPY --chown=${APP_USER}:${APP_USER} . /app

USER ${APP_UID}

ENV PATH=/home/${APP_USER}/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    FLASK_ENV=production \
    DEBUG=False

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:5000/health')" || exit 1

CMD ["python", "app_secure.py"]

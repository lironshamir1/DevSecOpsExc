# Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# Flask Configuration
SECRET_KEY=your-secret-key-here-generate-random-string
FLASK_ENV=development
FLASK_DEBUG=False

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp
DB_USER=dbuser
DB_PASSWORD=your-secure-database-password

# API Keys
API_KEY=your-api-key-here
EXTERNAL_API_KEY=your-external-service-api-key

# Encryption Keys
ENCRYPTION_KEY=your-encryption-key-32-characters
JWT_SECRET=your-jwt-secret-key

# Third-party Services
STRIPE_API_KEY=sk_test_your_stripe_key
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
GITHUB_TOKEN=ghp_your_github_token

# Session Configuration
SESSION_TYPE=filesystem
PERMANENT_SESSION_LIFETIME=1800

# SonarQube Configuration (for CI/CD)
SONAR_TOKEN=your-sonarqube-token
SONAR_HOST_URL=https://sonarqube.your-org.com

# Prisma Cloud Configuration (for CI/CD)
PRISMA_API_URL=https://api.prismacloud.io
PRISMA_ACCESS_KEY=your-prisma-access-key
PRISMA_SECRET_KEY=your-prisma-secret-key

# Generate secure random keys using:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
